[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[scripts]
list_outdated = "pip list --outdated"
tests = "coverage run -m pytest test"
tests_report = "coverage report --omit=./test/** --sort=cover --show-missing --skip-empty"

[packages]
email-validator = "==2.1.0.post1"
flask = "==3.1.3"
flask-cors = "==5.0.0"
flask-limiter = "==3.5.0"
gunicorn = "==22.0.0"
requests = "==2.33.0"
freezegun = "==1.5.1"
setuptools = "==83.0.0"
markupsafe= "==3.0.3"

[dev-packages]
coverage = "==7.4.4"
pytest = "==9.1.0"

[requires]
python_version = "3.12"
